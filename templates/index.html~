<!DOCTYPE html>
<html lang="">
  <head>
    <meta charset="utf-8">
    <title>Baseball Web App</title>
    <style>
        .table-container {
            display: flex;
            justify-content: space-around; /* Distributes space between and around tables */
            margin: 20px;
            gap: 20px; /* Adds space between the tables */
        }

        .table {
            border-collapse: collapse;
            width: 35%; /* Adjust width as needed */
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }
        header{
				text-align: center;
        }
        p{
			text-align: center;       
       }
    </style>
  </head>
  <body>
    <header><h1>Baseball Web App Home</h1></header>
    <main>
     <p><a href="{{ url_for('offszn_throwing_form') }}">Offseason Throwing Log</a></p>
     <p><a href="{{ url_for('dashboard') }}">Data Dashboard</a></p>
     
     <p><a href = "{{ url_for('throwing_plan') }}">Update Throwing Plan </a></p>
     <table border="1">
     			<caption><h3>Offseason Throwing Plan</h3></caption>
            <thead>
                <tr>
                    <th>Date Uploaded</th>
						  <th>Throwing Block</th>
						  <th># of Throwing Days</th>
						  <th>Session Breakdown</th>
						  <th>Throwing Notes</th>
						  <th>Pitching Notes</th>
						  
                </tr>
            </thead>
            <tbody>
                {% for data in throwing_plan %}
                <tr>
                	  <td>{{ data["date"] }}</td> {#date#}
                    <td>{{ data["throwing_block"] }}</td> {#throwing block#}
                    <td>{{ data["num_throwing_days"] }}</td> {#num throwing days#}
                    <td>{{ data["sessions_html"]  | safe }}</td> {#session breakdown#}
                    <td>{{ data["th_notes_html"]  | safe }}</td> {#throwing notes#}
                    <td>{{ data["p_notes_html"]  | safe }}</td> {#pitching notes#}
                </tr>
                {% endfor %}
            </tbody>
        </table>
      <div class = "table-container">
      <table class = "table" border="1">
            <thead>
                <tr>
                    <th>Drill Name</th>
                    <th>Drill Type</th>
						  <th>Ball Weight</th>
						  <th>Throw Count</th>
						  
                </tr>
            </thead>
            <tbody>
                {% for data in drills %}
                <tr>
                	  <td>{{ data[2] }}</td> {#Name#}
                    <td>{{ data[3] }}</td> {#Type#}
                    <td>{{ data[4] }}</td> {#Weight#}
                    <td>{{ data[5] }}</td> {#throw_count#}
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <table class="table">
        <thead><tr><th>Drill Notes</th></tr></thead>
        <tbody><tr>
        	{% for data in throwing_plan %}
					 	<td>{{ data["d_notes_html"]  | safe }}</td> {#drill notes#}
					 {% endfor %}
        </tr></tbody>     
         </table>    
         </div>    
		<table border="1">
            <thead>
                <tr>
                <td></td>
                    <th>Recent Throwing Notes</th>
                </tr>
            </thead>
            <tbody>
               	{% for data in throwing_notes %}
                <tr>
                	  <td>{{ data["date"] }}</td> {#date#}
                    <td>{{ data["notes_html"] | safe }}</td> {#notes#}
                </tr>
                {% endfor %}
          	
            </tbody>
        </table>
    </main>
    <footer></footer>
  </body>
</html>
