CREATE DATABASE throwing_log;

CREATE TABLE throwing_sessions (
 id INTEGER Primary Key AUTOINCREMENT;
 date Date NOT NULL;
 throwing_block TEXT;
 session_type TEXT;
 total_throws INTEGER;
 body_weight REAL;
 one_day_workload REAL;
 rpe INTEGER;
 arm_readiness INTEGER;
 notes VARCHAR
)

CREATE TABLE drills (
id INT Primary Key AUTOINCREMENT;
session_id INTEGER NOT NULL;
drill_name TEXT;
ball_weight REAL;
max_velocity REAL;
throw_count REAL;
FOREIGN KEY(session_id) REFERENCES(throwing_sessions(id)) ON DELETE CASCADE
)