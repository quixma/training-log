<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Training Dashboard</title>
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            background: #f4f4f4;
        }

        .dashboard-container {
            max-width: 1000px;
            margin: auto;
        }

        h1 {
            text-align: center;
        }

        .controls {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            background: white;
            padding: 15px;
            border-radius: 8px;
        }

        select {
            padding: 6px;
            border-radius: 4px;
        }

        .chart-area {
            background: white;
            padding: 20px;
            border-radius: 8px;
            min-height: 400px;
        }

        .summary-cards {
            margin-top: 30px;
            display: flex;
            gap: 20px;
        }

        .card {
            flex: 1;
            background: white;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <h1>Training Dashboard</h1>
    
        <!-- Controls -->
        <div class="controls">
            <div>
                <label>Metric:</label>
                <select id="metric-select">
                    <option value="">Select metric…</option>
                    <option value="body_weight">Bodyweight</option>
                    <option value="max_velo">Max Velo</option>
                    <option value="total_throws">Total Throws</option>
                    <option value = 'one_day_workload'>One Day Workload</option>
                    <option value="rpe">RPE</option>
                    <option value="arm_readiness">Arm Readiness</option>
                </select>
            </div>

            <div>
                <label>Time Range:</label>
                <select id="time-select">
                    <option value="">Select range…</option>
                    <option value="7">Last 7 days</option>
						  <option value="14">Last 14 days</option>
                    <option value="21">Last 21 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="60">Last 60 days</option>
                    <option value="90">Last 90 days</option>
                    
                </select>
            </div>
        </div>

        <!-- Chart Container -->
        <div class="chart-area">
            <canvas id="chart"></canvas>
            
        </div>

        <!-- Summary Cards (optional, for stats) -->
        <div class="summary-cards">
            <div class="card">
                <h3>Peak Velocity</h3>
                 {% for data in peak_velo %}
                	<p id="peak_velo">{{ data[0] }}</p>
                 {% endfor %}
            </div>
            <div class="card">
                <h3>Avg Readiness (7d)</h3>
                {% for data in avg_readiness %}
                	<p id="avg-readiness">{{ data[0] }}</p>
                {% endfor %}
            </div>
            <div class="card">
                <h3>Total Throws (7d)</h3>
                {% for data in total_throws %}
                	<p id="total-throws">{{ data[0] }}</p>
					 {% endfor %}
            </div>
        </div>

    </div>
    <script src="{{ url_for('static', filename='js/dashboard.js') }}"></script>
</body>
</html>

