# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# SQLite databases (ignore live user data)
*.db
*.sqlite3
*.sqbpro
#except ones in backup folder
!db_backup/*.db
!backup/*.db

# Flask instance folder (if used)
instance/

# Virtual environment
venv/
env/
ENV/
myenv/
.venv/
.env
.flaskenv

#ignore backup files
*~

# Node / frontend build artifacts (if you ever add npm)
node_modules/
dist/

# IDE / editor files
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
features.txt

#folders
/.claude
/other_scripts
/backup
/migrations
/tests
/docs

